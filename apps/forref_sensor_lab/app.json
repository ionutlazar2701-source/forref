{
  "configVersion": "v3",
  "app": {
    "appId": 30101,
    "appName": "FORREF SENS",
    "appType": "app",
    "version": {
      "code": 1,
      "name": "1.0.0"
    },
    "icon": "icon.png",
    "vender": "zepp",
    "description": "FORREF experimental sensor lab. Not a match record."
  },
  "permissions": [
    "data:os.device.info",
    "device:os.local_storage",
    "device:os.geolocation",
    "data:user.hd.heart_rate",
    "data:user.hd.distance",
    "device:os.bg_service"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "4.0",
      "target": "4.0",
      "minVersion": "3.0"
    }
  },
  "debug": false,
  "targets": {
    "gt": {
      "module": {
        "page": {
          "pages": [
            "page/gt/home/index.page",
            "page/gt/status/index.page",
            "page/gt/track/index.page",
            "page/gt/heat/index.page"
          ]
        },
        "app-service": {
          "services": [
            "app-service/hr_only"
          ]
        }
      },
      "platforms": [
        { "st": "s" }
      ],
      "designWidth": 390
    }
  },
  "i18n": {
    "en-US": { "appName": "FORREF SENS" },
    "ro-RO": { "appName": "FORREF SENS" }
  },
  "defaultLanguage": "en-US"
}
